# Python
**/.venv/
**/__pycache__/
*.pyc
*.pyo

# secrets — never commit
**/.env
.env

# OS
.DS_Store

# runtime FAISS index (built locally, not versioned)
app/data/index/*
!app/data/index/.gitkeep

# scratch
*.log

# QA용으로만 받은 타사 보험약관 PDF — 저작권 이슈로 저장소엔 안 올림.
# 정확한 출처/재현 방법은 TRACKING.md 참고. samsungfire_silson.pdf는 앱이
# 실제로 참조하는 데모 샘플이라 예외적으로 계속 커밋함.
app/samples/hyundai_실손_Hi2601.pdf
app/samples/hyundai_암보험_Hi2301.pdf
app/samples/kb_운전자보험_2308.pdf
app/samples/woori_종신보험_2601.pdf

